# Copy to .env and add your key. Never commit .env.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
# Optional: minimal | low | medium | high | xhigh (empty = model default)
REASONING_EFFORT=
# Pages per transcription call, and how many model calls may run at once
CHUNK_PAGES=8
MAX_PARALLEL_CALLS=4
