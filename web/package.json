{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "../.venv/bin/python ../scripts/dump_openapi.py > openapi.json && npx --yes openapi-typescript@7.13.0 openapi.json -o src/api/schema.d.ts",
